{
  "name": "deepseek-pocket",
  "version": "1.2.0",
  "private": false,
  "description": "DeepSeek 随身版：手机端 DeepSeek 客户端（Android APK + PWA），使用开放平台 API 与自有额度，支持深度思考、智能搜索、语音与多会话管理。",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nagatoquin33/deepseek-pocket.git"
  },
  "keywords": [
    "deepseek",
    "android",
    "apk",
    "pwa",
    "llm",
    "chat",
    "voice",
    "web-search"
  ],
  "scripts": {
    "start": "node server.mjs",
    "mock": "node server.mjs --mock",
    "https": "node server.mjs --https",
    "cert": "node tools/gen-cert.mjs",
    "doctor": "node tools/doctor.mjs",
    "test": "node --test",
    "build:android": "bash android/build.sh",
    "build:android:win": "powershell -ExecutionPolicy Bypass -File android/build.ps1",
    "qa": "node tools/qa/run.mjs",
    "qa:voice": "node tools/qa/voice-check.mjs",
    "shots": "node tools/qa/doc-shots.mjs"
  },
  "optionalDependencies": {
    "qrcode": "^1.5.4"
  }
}
