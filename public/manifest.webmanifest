{
  "name": "DeepSeek 随身版",
  "short_name": "DeepSeek",
  "description": "使用你自己的 DeepSeek 开放平台额度：深度思考、联网搜索、语音对话与多会话管理。",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#FFFFFF",
  "theme_color": "#4D6BFE",
  "lang": "zh-CN",
  "dir": "ltr",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "新建对话",
      "short_name": "新对话",
      "url": "/?screen=new"
    },
    {
      "name": "搜索网页",
      "short_name": "搜索",
      "url": "/?screen=search"
    }
  ]
}